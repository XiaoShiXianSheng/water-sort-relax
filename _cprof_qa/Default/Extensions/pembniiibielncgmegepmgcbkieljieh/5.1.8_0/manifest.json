{
   "action": {
      "default_icon": "/assets/img/icon-48.png",
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "assets/js/background.js"
   },
   "content_scripts": [ {
      "css": [  ],
      "js": [ "assets/js/chunk-vendors.js", "assets/js/chunk-common.js", "assets/js/content.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_end"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
   },
   "default_locale": "en",
   "description": "__MSG_extDescription__",
   "externally_connectable": {
      "matches": [ "http://*/*", "https://*/*" ]
   },
   "homepage_url": "https://www.zying.net",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "assets/img/icon-128.png",
      "16": "assets/img/icon-16.png",
      "256": "assets/img/icon-256.png",
      "32": "assets/img/icon-32.png",
      "48": "assets/img/icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "optional_permissions": [ "cookies", "alarms" ],
   "options_page": "landing.html",
   "permissions": [ "tabs", "storage", "declarativeNetRequestWithHostAccess", "contextMenus" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "5.1.8",
   "web_accessible_resources": [ {
      "matches": [ "http://*/*", "https://*/*" ],
      "resources": [ "assets/data/*", "assets/js/async/*", "assets/js/inject-*.js", "assets/js/iconfont-zying.js", "assets/css/*", "assets/css/async/*", "assets/img/*", "assets/flag/*" ]
   } ]
}
